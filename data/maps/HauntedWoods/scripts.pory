    "I keep vigil over this spectral\n"
    "flame.\p"
    "Would you like to adjust its aura?"
}

text HauntedWoods_Text_OptToggleLight {
    "Toggle Light (On/Off)"
}

text HauntedWoods_Text_OptFlameSize {
    "Flame Size"
}

text HauntedWoods_Text_OptToggleMove {
    "Toggle 2x2 Movement"
}

text HauntedWoods_Text_OptExit {
    "Exit"
}

text HauntedWoods_Text_OptBack {
    "Back"
}

text HauntedWoods_Text_LightTurnedOn {
    "The spectral flame reignites with\n"
    "an eerie glow."
}

text HauntedWoods_Text_LightTurnedOff {
    "The spectral flame has been\n"
    "extinguished."
}

text HauntedWoods_Text_SelectSizePrompt {
    "Select the flame's intensity:"
}

text HauntedWoods_Text_OptSize50 {
    "50% Size (Dim)"
}

text HauntedWoods_Text_OptSize100 {
    "100% Size (Normal)"
}

text HauntedWoods_Text_OptSize150 {
    "150% Size (Blazing)"
}

text HauntedWoods_Text_SizeSet50 {
    "The flame shrinks to a faint\n"
    "50% glow."
}

text HauntedWoods_Text_SizeSet100 {
    "The flame burns at its default 100%."
}

text HauntedWoods_Text_SizeSet150 {
    "The flame blazes outwards to 150%!"
}

text HauntedWoods_Text_MoveStarted {
    "The flame begins its 2x2 patrol."
}

text HauntedWoods_Text_MoveStopped {
    "The flame returns to resting\n"
    "in place."
}

text HauntedWoods_Text_KeeperFarewell {
    "May the flame light your passage\n"
    "through the dark."
}

script HauntedWoods_EventScript_FlashlightScientist {
    lock
    faceplayer
    checkitem(ITEM_FLASHLIGHT, 1)
    if (var(VAR_RESULT) == FALSE && !flag(FLAG_RECEIVED_FLASHLIGHT)) {
        msgbox(HauntedWoods_Text_ScientistIntroNoFlashlight, MSGBOX_DEFAULT)
        giveitem(ITEM_FLASHLIGHT, 1)
        giveitem(ITEM_ESCAPE_ROPE, 1)
        setflag(FLAG_RECEIVED_FLASHLIGHT)
        clearflag(FLAG_FLASHLIGHT_DISABLED)
        special(Special_UpdateMapLightSources)
        msgbox(HauntedWoods_Text_ScientistGaveFlashlight, MSGBOX_DEFAULT)
        closemessage
        release
        end
    }

    message(HauntedWoods_Text_ScientistTestPrompt)
    waitmessage
    dynmultipush(HauntedWoods_Text_OptKeepFlashlight, 0)
    dynmultipush(HauntedWoods_Text_OptToggleFlashlight, 1)
    dynmultipush(HauntedWoods_Text_OptGetEscapeRope, 2)
    dynmultistack(0, 0, FALSE, 3, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    switch (var(VAR_RESULT)) {
        case 1:
            goto(HauntedWoods_EventScript_ToggleFlashlightTesting)
        case 2:
            giveitem(ITEM_ESCAPE_ROPE, 1)
            msgbox(HauntedWoods_Text_ScientistGaveEscapeRope, MSGBOX_DEFAULT)
        default:
            msgbox(HauntedWoods_Text_ScientistKeepFlashlight, MSGBOX_DEFAULT)
    }
    closemessage
    release
    end
}

script HauntedWoods_EventScript_ToggleFlashlightTesting {
    if (flag(FLAG_FLASHLIGHT_DISABLED)) {
        clearflag(FLAG_FLASHLIGHT_DISABLED)
        special(Special_UpdateMapLightSources)
        msgbox(HauntedWoods_Text_ScientistReturnedFlashlight, MSGBOX_DEFAULT)
    } else {
        setflag(FLAG_FLASHLIGHT_DISABLED)
        special(Special_UpdateMapLightSources)
        msgbox(HauntedWoods_Text_ScientistRemovedFlashlight, MSGBOX_DEFAULT)
    }
    closemessage
    release
    end
}

text HauntedWoods_Text_ScientistIntroNoFlashlight {
    "Phew! It's pitch-black out here...\p"
    "Good thing I fitted my torch with an\n"
    "amber lens filter.\p"
    "Standard white light scatters too\n"
    "much in this spectral mist, but this\l"
    "warm beam cuts right through it!\p"
    "Wait, you don't even have a\n"
    "flashlight?\p"
    "You won't be able to see a single\n"
    "step in these haunted woods!\p"
    "Here, take this spare Flashlight!\n"
    "And take an Escape Rope too, just\l"
    "in case you ever lose your bearings."
}

text HauntedWoods_Text_ScientistGaveFlashlight {
    "Click! There you go! Your\n"
    "Flashlight is now shining bright.\p"
    "If the darkness ever overwhelms you,\n"
    "remember you can use your Escape\l"
    "Rope to warp safely back out!"
}

text HauntedWoods_Text_ScientistTestPrompt {
    "How is that Flashlight treating you?\p"
    "I'm running tests on visibility and\n"
    "light dispersion in this fog.\p"
    "Would you like to adjust your\n"
    "lighting for feature testing?"
}

text HauntedWoods_Text_OptKeepFlashlight {
    "Keep Flashlight"
}

text HauntedWoods_Text_OptToggleFlashlight {
    "Toggle Flashlight (On/Off)"
}

text HauntedWoods_Text_OptGetEscapeRope {
    "Extra Escape Rope"
}

text HauntedWoods_Text_ScientistKeepFlashlight {
    "Safe travels through the\n"
    "haunted mist!"
}

text HauntedWoods_Text_ScientistGaveEscapeRope {
    "Here's another Escape Rope!\n"
    "Always keep one handy in the dark."
}

text HauntedWoods_Text_ScientistRemovedFlashlight {
    "Click! Flashlight returned\n"
    "and packed away.\p"
    "Notice how the woods return to\n"
    "complete pitch-black darkness?"
}

text HauntedWoods_Text_ScientistReturnedFlashlight {
    "Click!\n"
    "Flashlight switched back on!\p"
    "Your amber beam cuts right through\n"
    "the gloomy mist."
}

script HauntedWoods_EventScript_FlashlightTrainer {
    trainerbattle_single(TRAINER_CAMPER_2, HauntedWoods_Text_FlashlightTrainerIntro, HauntedWoods_Text_FlashlightTrainerDefeat)
    msgbox(HauntedWoods_Text_FlashlightTrainerPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text HauntedWoods_Text_FlashlightTrainerIntro {
    "Click!\n"
    "Caught you in my flashlight beam!"
}

text HauntedWoods_Text_FlashlightTrainerDefeat {
    "Aww! You blinded me with your skill!"
}

text HauntedWoods_Text_FlashlightTrainerPostBattle {
    "It's dangerous to explore the woods\n"
    "without a light.\p"
    "Keep your wits about you!"
}


