const LOCALID_AGATHA = 6
// 2. Map scripts table
mapscripts SSAnne_1F_Room6_MapScripts {
    // Triggers on map frame entry if the story variable is 1
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MAP_SCENE_S_S_MINNOW_1F_CORRIDOR, 0: SSMinnow_1F_EventScript_ChoosePokemonCutscene
    ]
}

script SSMinnow_1F_EventScript_ChoosePokemonCutscene {
    lockall
    // Set variable to 2 so this cutscene doesn't loop forever
    setvar(VAR_MAP_SCENE_S_S_MINNOW_1F_CORRIDOR, 1)

    applymovement(OBJ_EVENT_ID_PLAYER, SSMinnow_1F_Room6_Movement_Player)
    applymovement(LOCALID_AGATHA, SSMinnow_1F_Room6_Movement_Agatha)
    waitmovement(0)

    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("Ah. There you both are.\p"
            "We'll be in Vermilion Harbor\n"
           "inside the hour. I want you ready.\p"

			"Silph brought us here to help\n"
			"in their research of Pokémon\l"
			"containment devices. \p"

           "To do that, you'll need a partner\n"
           "Pokémon.\p"
           "I've given this some thought.\n"
           "There are three on the table.\p"
           "I'll let you look them over before\n"
           "you decide. Oak, the choice is\l"
           "yours first.")
    closemessage
    releaseall
    end
}

script SSAnne_1F_Room6_EventScript_FinishStarterSelection{
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("Good. Take care of it.\p"
           "Whatever you're planning to do out\n"
           "there, your partner's condition will\l"
           "matter more than you think.")
    closemessage
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    msgbox("Alright, Agatha. Go ahead.")
    closemessage
    showmugshot(MUGSHOT_AGATHA, MUGSHOT_LEFT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("Oh, no thanks, Professor.\p"
           "All of these ones look a bit too\n"
           "weak for me.\p"
           "I'll go out and get one for myself.")
    closemessage
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("Alright, don't take too long.")
    closemessage
    applymovement(LOCALID_AGATHA, SSMinnow_1F_Room6_Movement_Agatha_Leaves)
    waitmovement(0)
    removeobject(LOCALID_AGATHA)
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    msgbox("She'll be fine. She always is.\p"
    "Gather your things. I'll find you\n"
           "in the city once you're off the ship.")
    closemessage
    clearmugshot
    setflag(FLAG_SYS_POKEMON_GET)
    release
    end
}

script SSAnne_1F_Room6_EventScript_Agatha{
    lock
    faceplayer
    showmugshot(MUGSHOT_AGATHA, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("Go ahead and pick, Sammy!")
    closemessage
    release
    end
}

script SSAnne_1F_Room6_EventScript_Arbor{
    lock
    faceplayer
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    if (flag(FLAG_SYS_POKEMON_GET)) {
        msgbox("The harbor's close now.\n"
               "Get your things together.")
    } else {
        msgbox("Take your time. But not too much.")
    }
    closemessage
    release
    end
}

// 4. Movement Sequences
movement SSMinnow_1F_Room6_Movement_Player {
    walk_down * 1
}
movement SSMinnow_1F_Room6_Movement_Agatha {
    delay_16
    walk_right * 1       
    face_down
}
movement SSMinnow_1F_Room6_Movement_Agatha_Leaves {
    walk_up * 1
    set_invisible        
}

raw`
SSAnne_1F_Room6_EventScript_Woman::
	lock
	faceplayer
	msgbox SSAnne_1F_Room6_Text_TakeAShortRest, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SSAnne_1F_Room6_EventScript_DeclineHeal
	closemessage
	call EventScript_OutOfCenterPartyHeal
	msgbox SSAnne_1F_Room6_Text_GladEveryoneIsRefreshed
	release
	end

SSAnne_1F_Room6_EventScript_DeclineHeal::
	checkplayergender
	goto_if_eq VAR_RESULT, MALE, SSAnne_1F_Room6_EventScript_DeclineHealMale
	msgbox SSAnne_1F_Room6_Text_SorryYouLookLikeMySister
	release
	end

SSAnne_1F_Room6_EventScript_DeclineHealMale::
	msgbox SSAnne_1F_Room6_Text_SorryYouLookLikeMyBrother
	release
	end

SSAnne_1F_Room6_EventScript_Growlithe::
	lock
	faceplayer
	goto_if_set FLAG_SYS_POKEMON_GET, SSAnne_1F_Room6_EventScript_GrowlitheAlreadyChose
	showmugshot MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT
	textcolor NPC_TEXT_COLOR_MALE
	msgbox SSAnne_1F_Room6_Text_ArborNoteGrowlithe, MSGBOX_DEFAULT
	clearmugshot
	showmonpic SPECIES_GROWLITHE, 10, 3
	playmoncry SPECIES_GROWLITHE, CRY_MODE_NORMAL
	msgbox SSAnne_1F_Room6_Text_ChooseGrowlithe, MSGBOX_YESNO
	waitmoncry
	goto_if_eq VAR_RESULT, YES, SSAnne_1F_Room6_EventScript_ChooseGrowlithe
	hidemonpic
	release
	end

SSAnne_1F_Room6_EventScript_GrowlitheAlreadyChose::
	playmoncry SPECIES_GROWLITHE, CRY_MODE_NORMAL
	msgbox SSAnne_1F_Room6_Text_GrowlitheFriendly
	waitmoncry
	release
	end

SSAnne_1F_Room6_EventScript_ChooseGrowlithe::
	hidemonpic
	givemon SPECIES_GROWLITHE, 5, ball=ITEM_RED_PROTOBALL
	goto_if_eq VAR_RESULT, 0, SSAnne_1F_Room6_EventScript_GiveGrowlitheParty
	goto_if_eq VAR_RESULT, 1, SSAnne_1F_Room6_EventScript_GiveGrowlithePC
	goto_if_eq VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon
	end

SSAnne_1F_Room6_EventScript_GiveGrowlitheParty::
	setflag FLAG_0x8D7
	removeobject 2
	playfanfare MUS_LEVEL_UP
	message SSAnne_1F_Room6_Text_ObtainedGrowlithe
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_GROWLITHE
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SSAnne_1F_Room6_EventScript_FinishStarterSelection
	call EventScript_GetGiftMonPartySlot
	call EventScript_ChangePokemonNickname
	goto SSAnne_1F_Room6_EventScript_FinishStarterSelection
	end

SSAnne_1F_Room6_EventScript_GiveGrowlithePC::
	setflag FLAG_0x8D7
	removeobject 2
	playfanfare MUS_LEVEL_UP
	message SSAnne_1F_Room6_Text_ObtainedGrowlithe
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_GROWLITHE
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, SSAnne_1F_Room6_EventScript_GrowlitheTransferredToPC
	call EventScript_NameReceivedBoxMon
	goto SSAnne_1F_Room6_EventScript_GrowlitheTransferredToPC
	end

SSAnne_1F_Room6_EventScript_GrowlitheTransferredToPC::
	call EventScript_TransferredToPC
	goto SSAnne_1F_Room6_EventScript_FinishStarterSelection
	end

