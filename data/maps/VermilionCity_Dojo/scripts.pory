// VermilionCity_Dojo/scripts.pory
//
// Basic wiring pass: all four trainers are plain standard battles for now.
// Yuki's team-preview rematch, Jin's turn limit, and Akio's monotype
// restriction are intentionally left out until those mechanics are
// layered back in.
//
// CHALLENGE GUY picks a belt tier (White/Blue/Black) or Training mode via
// VAR_DOJO_CHALLENGE_TIER (1=White, 2=Blue, 3=Black). Each student reads
// that var to decide which of their _WHITE/_BLUE/_BLACK trainer IDs to use.
// Blue requires all four *_WHITE_DEFEATED flags; Black requires all four
// *_BLUE_DEFEATED flags. Training always fights the player's highest
// currently-unlocked tier with FLAG_SCALE_BOSS_BATTLE applied (offset -1)
// so it scales up alongside the player but stays a slight handicap at any
// level, and does NOT set the *_DEFEATED progression flags — only a real
// White/Blue/Black clear counts. Training also force-clears the relevant
// trainer's beaten flag before every fight (like Gauntlet does for Black),
// since otherwise a tier already cleared for real would just skip the
// battle instead of letting the player grind it.

mapscripts VermilionCity_Dojo_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: VermilionCity_Dojo_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: VermilionCity_Dojo_OnFrame
    ]
}

// Safety net: clears FLAG_SCALE_BOSS_BATTLE and FLAG_DOJO_TRAINING_MODE on
// every map entry so a stray scaled/training battle flag can never leak in
// from elsewhere and affect a Dojo trainer.
//
// Also wipes GAUNTLET progress on every entry. The Gauntlet must be cleared
// in one sitting -- walking out (to heal, to the PC, anywhere) and back in
// fires this transition, so any partial run is voided and the player has to
// start over from Ryu.
//
// Also resets VAR_DOJO_CHALLENGE_TIER to 0 (no tier selected). Without this,
// leaving mid-Gauntlet left the tier stuck at 4 -- walking straight up to a
// student without talking to the Challenge Guy again would silently start
// a Gauntlet-style Black Belt fight (pre-battle flag clear, DONE flag on
// win) that could never actually complete, since the DONE flags were just
// wiped above. Resetting to 0 forces a real tier selection every visit;
// 0 falls through to the White Belt trainer IDs in each student's script,
// same as any other not-yet-selected value.
script VermilionCity_Dojo_OnTransition {
    clearflag(FLAG_SCALE_BOSS_BATTLE)
    clearflag(FLAG_DOJO_TRAINING_MODE)
    clearflag(FLAG_DOJO_GAUNTLET_RYU_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_YUKI_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_JIN_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_AKIO_DONE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 0)
    end
}

// First-ever dojo visit (any dojo, tracked by one shared flag) gets the
// Challenge Guy intro explaining belts and Training mode. Must be run on the
// frame table (not ON_RESUME or ON_LOAD) because dialogue/blocking scripts
// cannot be run synchronously during map loading.
//
// Also starts the ATTACK DOJO CHALLENGE quest (FLAG_QUEST_ATTACK_DOJO_ACTIVE, see
// src/quest_log_menu.c) on first entry to THIS specific dojo, with a toast
// notification -- separate from the shared dojo-intro flag above since this
// one is Vermilion-specific, not shared across every dojo.
script VermilionCity_Dojo_OnFrame {
    setvar(VAR_TEMP_0, 1)
    if (!flag(FLAG_SEEN_DOJO_INTRO)) {
        call(Common_EventScript_DojoIntro)
    }
    if (!flag(FLAG_QUEST_ATTACK_DOJO_ACTIVE)) {
        setflag(FLAG_QUEST_ATTACK_DOJO_ACTIVE)
        quest_start_toast("ATTACK DOJO CHALLENGE")
    }
    end
}

// ============================================================================
// CHALLENGE GUY — picks the belt tier used by Ryu/Yuki/Jin/Akio
// ============================================================================

script VermilionCity_Dojo_EventScript_ChallengeGuy {
    lock
    faceplayer
    // Gauntlet only appears once all four students have been beaten for
    // real at Black Belt -- it's a hidden challenge, not an advertised one.
    if (flag(FLAG_DOJO_RYU_BLACK_DEFEATED) && flag(FLAG_DOJO_YUKI_BLACK_DEFEATED) && flag(FLAG_DOJO_JIN_BLACK_DEFEATED) && flag(FLAG_DOJO_AKIO_BLACK_DEFEATED)) {
        msgbox(VermilionCity_Dojo_Text_ChallengeGuyIntroGauntlet, MSGBOX_DEFAULT)
        closemessage
        multichoice(0, 0, MULTI_DOJO_CHALLENGE_GAUNTLET, FALSE)
        if (var(VAR_RESULT) == 4) {
            goto(VermilionCity_Dojo_EventScript_ChallengeGauntlet)
            end
        }
        if (var(VAR_RESULT) == 5) {
            release
            end
        }
    } else {
        msgbox(VermilionCity_Dojo_Text_ChallengeGuyIntro, MSGBOX_DEFAULT)
        closemessage
        multichoice(0, 0, MULTI_DOJO_CHALLENGE, FALSE)
    }
    if (var(VAR_RESULT) == 0) {
        goto(VermilionCity_Dojo_EventScript_ChallengeTraining)
        end
    }
    if (var(VAR_RESULT) == 1) {
        goto(VermilionCity_Dojo_EventScript_ChallengeWhite)
        end
    }
    if (var(VAR_RESULT) == 2) {
        goto(VermilionCity_Dojo_EventScript_ChallengeBlue)
        end
    }
    if (var(VAR_RESULT) == 3) {
        goto(VermilionCity_Dojo_EventScript_ChallengeBlack)
        end
    }
    release
    end
}

script VermilionCity_Dojo_EventScript_ChallengeTraining {
    setflag(FLAG_DOJO_TRAINING_MODE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 1)
    if (flag(FLAG_DOJO_RYU_WHITE_DEFEATED) && flag(FLAG_DOJO_YUKI_WHITE_DEFEATED) && flag(FLAG_DOJO_JIN_WHITE_DEFEATED) && flag(FLAG_DOJO_AKIO_WHITE_DEFEATED)) {
        setvar(VAR_DOJO_CHALLENGE_TIER, 2)
    }
    if (flag(FLAG_DOJO_RYU_BLUE_DEFEATED) && flag(FLAG_DOJO_YUKI_BLUE_DEFEATED) && flag(FLAG_DOJO_JIN_BLUE_DEFEATED) && flag(FLAG_DOJO_AKIO_BLUE_DEFEATED)) {
        setvar(VAR_DOJO_CHALLENGE_TIER, 3)
    }
    msgbox(VermilionCity_Dojo_Text_ChallengeTrainingSet, MSGBOX_AUTOCLOSE)
    release
    end
}

script VermilionCity_Dojo_EventScript_ChallengeWhite {
    clearflag(FLAG_DOJO_TRAINING_MODE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 1)
    msgbox(VermilionCity_Dojo_Text_ChallengeWhiteSet, MSGBOX_AUTOCLOSE)
    release
    end
}

script VermilionCity_Dojo_EventScript_ChallengeBlue {
    if (!flag(FLAG_DOJO_RYU_WHITE_DEFEATED) || !flag(FLAG_DOJO_YUKI_WHITE_DEFEATED) || !flag(FLAG_DOJO_JIN_WHITE_DEFEATED) || !flag(FLAG_DOJO_AKIO_WHITE_DEFEATED)) {
        msgbox(VermilionCity_Dojo_Text_ChallengeBlueLocked, MSGBOX_AUTOCLOSE)
        release
        end
    }
    clearflag(FLAG_DOJO_TRAINING_MODE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 2)
    msgbox(VermilionCity_Dojo_Text_ChallengeBlueSet, MSGBOX_AUTOCLOSE)
    release
    end
}

script VermilionCity_Dojo_EventScript_ChallengeBlack {
    if (!flag(FLAG_DOJO_RYU_BLUE_DEFEATED) || !flag(FLAG_DOJO_YUKI_BLUE_DEFEATED) || !flag(FLAG_DOJO_JIN_BLUE_DEFEATED) || !flag(FLAG_DOJO_AKIO_BLUE_DEFEATED)) {
        msgbox(VermilionCity_Dojo_Text_ChallengeBlackLocked, MSGBOX_AUTOCLOSE)
        release
        end
    }
    clearflag(FLAG_DOJO_TRAINING_MODE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 3)
    msgbox(VermilionCity_Dojo_Text_ChallengeBlackSet, MSGBOX_AUTOCLOSE)
    release
    end
}

// GAUNTLET (var 4): all four Black Belt trainers, back to back, no leaving
// to heal. Selecting it (re)starts a fresh attempt -- and OnTransition
// wipes progress the moment the player steps off this map, so the only way
// to bank a DONE flag is to keep winning without leaving.
script VermilionCity_Dojo_EventScript_ChallengeGauntlet {
    clearflag(FLAG_DOJO_TRAINING_MODE)
    setvar(VAR_DOJO_CHALLENGE_TIER, 4)
    clearflag(FLAG_DOJO_GAUNTLET_RYU_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_YUKI_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_JIN_DONE)
    clearflag(FLAG_DOJO_GAUNTLET_AKIO_DONE)
    msgbox(VermilionCity_Dojo_Text_ChallengeGauntletSet, MSGBOX_AUTOCLOSE)
    release
    end
}

// Shared by all four students' win handlers in Gauntlet mode. Awards the
// one-time GAUNTLET_CLEARED flag (and its message) the moment all four
// DONE flags are set in the same sitting -- guarded so it only ever fires
// once, no matter which student happens to finish the run.
script VermilionCity_Dojo_EventScript_CheckGauntletComplete {
    if (flag(FLAG_DOJO_GAUNTLET_CLEARED)) {
        return
    }
    if (flag(FLAG_DOJO_GAUNTLET_RYU_DONE) && flag(FLAG_DOJO_GAUNTLET_YUKI_DONE) && flag(FLAG_DOJO_GAUNTLET_JIN_DONE) && flag(FLAG_DOJO_GAUNTLET_AKIO_DONE)) {
        setflag(FLAG_DOJO_GAUNTLET_CLEARED)
        msgbox(VermilionCity_Dojo_Text_GauntletCleared, MSGBOX_DEFAULT)
        closemessage
    }
    return
}

// Shared by all four students' win handlers. The ATTACK DOJO CHALLENGE quest
// is only actually complete once all four have been beaten for real at
// Black Belt -- since students can be fought in any order, awarding it off
// of a single student's Black win (as this used to do, gated on Akio alone)
// would complete the quest with the other three still unbeaten. Guarded on
// the completeFlag itself so it only ever fires once, no matter which
// student happens to be the one who finishes it.
script VermilionCity_Dojo_EventScript_CheckAttackDojoComplete {
    if (flag(FLAG_QUEST_ATTACK_DOJO_COMPLETED)) {
        return
    }
    if (flag(FLAG_DOJO_RYU_BLACK_DEFEATED) && flag(FLAG_DOJO_YUKI_BLACK_DEFEATED) && flag(FLAG_DOJO_JIN_BLACK_DEFEATED) && flag(FLAG_DOJO_AKIO_BLACK_DEFEATED)) {
        setflag(FLAG_QUEST_ATTACK_DOJO_COMPLETED)
        quest_complete_toast("ATTACK DOJO CHALLENGE")
    }
    return
}

// Called on every post-battle path (both the "already beaten, battle
// skipped" fallthrough and the real win handler) for all four students.
// FLAG_SCALE_BOSS_BATTLE/VAR_SCALE_LEVEL_OFFSET and FLAG_PREVIEW_BATTLE/
// var 0x8008 are set right before each trainerbattle_single call, but
// dotrainerbattle only clears FLAG_PREVIEW_BATTLE itself when the battle
// actually runs -- if the trainer flag is already set, the battle is
// skipped entirely and both pairs would otherwise leak, scaling and
// preview-ing every trainer battle for the rest of the game.
script VermilionCity_Dojo_EventScript_PostBattleCleanup {
    clearflag(FLAG_SCALE_BOSS_BATTLE)
    setvar(VAR_SCALE_LEVEL_OFFSET, 0)
    clearflag(FLAG_PREVIEW_BATTLE)
    setvar(0x8008, 0)
    return
}

// ============================================================================
// STUDENT RYU — basic trainer
// ============================================================================

script VermilionCity_Dojo_EventScript_Ryu {
    lock
    faceplayer
    msgbox("Are you ready?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox("Come back when you're ready.")
        closemessage
        release
        end
    }
    setflag(FLAG_PREVIEW_BATTLE)
    setvar(0x8008, 2)
    if (flag(FLAG_DOJO_TRAINING_MODE)) {
        setflag(FLAG_SCALE_BOSS_BATTLE)
        setvar(VAR_SCALE_LEVEL_OFFSET, -1)
    } else {
        setflag(FLAG_SCALE_BOSS_BATTLE)
        if (var(VAR_DOJO_CHALLENGE_TIER) == 4 || var(VAR_DOJO_CHALLENGE_TIER) == 3) {
            setvar(VAR_SCALE_LEVEL_OFFSET, 5)
        } else {
            if (var(VAR_DOJO_CHALLENGE_TIER) == 2) {
                setvar(VAR_SCALE_LEVEL_OFFSET, 2)
            } else {
                setvar(VAR_SCALE_LEVEL_OFFSET, 0)
            }
        }
    }
    if (var(VAR_DOJO_CHALLENGE_TIER) == 4) {
        // Gauntlet must always be a real fight, even if this trainer's
        // permanent Black Belt flag is already set from an earlier clear.
        clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_BLACK)
        trainerbattle_single(TRAINER_BLACK_BELT_RYU_BLACK, VermilionCity_Dojo_Text_RyuIntro, VermilionCity_Dojo_Text_RyuDefeat, VermilionCity_Dojo_EventScript_RyuWon)
    } else {
        if (var(VAR_DOJO_CHALLENGE_TIER) == 3) {
            // Training must always be a real, re-fightable fight too -- same
            // reasoning as Gauntlet above, otherwise Training locks up dead
            // the moment this tier's trainer has been beaten for real once.
            if (flag(FLAG_DOJO_TRAINING_MODE)) {
                clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_BLACK)
            }
            trainerbattle_single(TRAINER_BLACK_BELT_RYU_BLACK, VermilionCity_Dojo_Text_RyuIntro, VermilionCity_Dojo_Text_RyuDefeat, VermilionCity_Dojo_EventScript_RyuWon)
        } else {
            if (var(VAR_DOJO_CHALLENGE_TIER) == 2) {
                if (flag(FLAG_DOJO_TRAINING_MODE)) {
                    clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_BLUE)
                }
                trainerbattle_single(TRAINER_BLACK_BELT_RYU_BLUE, VermilionCity_Dojo_Text_RyuIntro, VermilionCity_Dojo_Text_RyuDefeat, VermilionCity_Dojo_EventScript_RyuWon)
            } else {
                if (flag(FLAG_DOJO_TRAINING_MODE)) {
                    clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_WHITE)
                }
                trainerbattle_single(TRAINER_BLACK_BELT_RYU_WHITE, VermilionCity_Dojo_Text_RyuIntro, VermilionCity_Dojo_Text_RyuDefeat, VermilionCity_Dojo_EventScript_RyuWon)
            }
        }
    }
    // Only reached if the trainer was already beaten and the battle was
    // skipped -- a genuine win jumps straight to RyuWon below instead.
    call(VermilionCity_Dojo_EventScript_PostBattleCleanup)
    msgbox(VermilionCity_Dojo_Text_RyuPost, MSGBOX_AUTOCLOSE)
    end
}

// trainerbattle_single's 4th-arg win handler REPLACES the rest of
// EventScript_Ryu on an actual win (mode TRAINER_BATTLE_CONTINUE_SCRIPT
// jumps here directly via gotobeatenscript) -- it does not resume after
// the trainerbattle_single call, so all post-battle logic must live here.
script VermilionCity_Dojo_EventScript_RyuWon {
    if (var(VAR_DOJO_CHALLENGE_TIER) == 4) {
        setflag(FLAG_DOJO_GAUNTLET_RYU_DONE)
        call(VermilionCity_Dojo_EventScript_CheckGauntletComplete)
    } else {
        if (var(VAR_DOJO_CHALLENGE_TIER) == 3) {
            if (flag(FLAG_DOJO_TRAINING_MODE)) {
                clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_BLACK)
            } else {
                setflag(FLAG_DOJO_RYU_BLACK_DEFEATED)
                call(VermilionCity_Dojo_EventScript_CheckAttackDojoComplete)
            }
        } else {
            if (var(VAR_DOJO_CHALLENGE_TIER) == 2) {
                if (!flag(FLAG_DOJO_TRAINING_MODE)) {
                    setflag(FLAG_DOJO_RYU_BLUE_DEFEATED)
                } else {
                    clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_BLUE)
                }
            } else {
                if (!flag(FLAG_DOJO_TRAINING_MODE)) {
                    setflag(FLAG_DOJO_RYU_WHITE_DEFEATED)
                } else {
                    clearflag(TRAINER_FLAGS_START + TRAINER_BLACK_BELT_RYU_WHITE)
                }
            }
        }
    }
    // Training mode heals the party on every win so grinding doesn't wear
    // the player down between fights. Balancing (partial heal, cap on
    // frequency, etc.) can be revisited later.
    if (flag(FLAG_DOJO_TRAINING_MODE)) {
        special(HealPlayerParty)
    }
    call(VermilionCity_Dojo_EventScript_PostBattleCleanup)
    msgbox(VermilionCity_Dojo_Text_RyuPost, MSGBOX_AUTOCLOSE)
    release
    end
}

