script VermilionCity_Dojo_EventScript_AkioFirstDefeat {
    // setflag(FLAG_DOJO_AKIO_DEFEATED)
    giveitem(ITEM_TM34, 1)
    release
    end
}

// ============================================================================
// SENSEI AKIO — basic trainer, gives a TM on first win, idles after
// ============================================================================

script VermilionCity_Dojo_EventScript_Akio {
    lock
    faceplayer
    if (flag(FLAG_DOJO_AKIO_DEFEATED)) {
        goto(VermilionCity_Dojo_EventScript_AkioIdle)
    }
    msgbox("Are you ready?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
    msgbox("Come back when you're ready.")
    closemessage
    release
    end
}
    setflag(FLAG_PREVIEW_BATTLE)
    setvar(0x8008, 2)
    trainerbattle_single(TRAINER_EXPERT_AKIO, VermilionCity_Dojo_Text_AkioIntro, VermilionCity_Dojo_Text_AkioDefeat, VermilionCity_Dojo_EventScript_AkioFirstDefeat)
    msgbox(VermilionCity_Dojo_Text_AkioPostBattle, MSGBOX_AUTOCLOSE)
    end
}

script VermilionCity_Dojo_EventScript_AkioFirstDefeat {
    setflag(FLAG_DOJO_AKIO_DEFEATED)
    giveitem(ITEM_TM34, 1)
    release
    end
}

script VermilionCity_Dojo_EventScript_AkioIdle {
    msgbox(VermilionCity_Dojo_Text_AkioIdle, MSGBOX_NPC)
    release
    end
}

// ============================================================================
// OVERWORLD POKéMON
// ============================================================================

script VermilionCity_Dojo_EventScript_Machop {
    lock
    faceplayer
    playmoncry(SPECIES_MACHOP, CRY_MODE_NORMAL)
    msgbox(VermilionCity_Dojo_Text_Machop, MSGBOX_DEFAULT)
    waitmoncry
    release
    end
}

script VermilionCity_Dojo_EventScript_Mankey {
    lock
    faceplayer
    playmoncry(SPECIES_MANKEY, CRY_MODE_NORMAL)
    msgbox(VermilionCity_Dojo_Text_Mankey, MSGBOX_DEFAULT)
    waitmoncry
    release
    end
}

script VermilionCity_Dojo_EventScript_Hitmonchan {
    lock
    faceplayer
    playmoncry(SPECIES_HITMONCHAN, CRY_MODE_NORMAL)
    msgbox(VermilionCity_Dojo_Text_Hitmonchan, MSGBOX_DEFAULT)
    waitmoncry
    release
    end
}

