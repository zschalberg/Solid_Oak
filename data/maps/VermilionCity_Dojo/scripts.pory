// ============================================================================
// TEXT
// ============================================================================

text VermilionCity_Dojo_Text_RyuIntro {
    "Before you reach Sensei,\n"
    "you pass through me.\p"
    "Show me you belong here."
}

text VermilionCity_Dojo_Text_RyuDefeat {
    "You've got something in you."
}

text VermilionCity_Dojo_Text_RyuPost {
    "The next two fight differently.\n"
    "Pay attention to how they\l"
    "come at you."
}

text VermilionCity_Dojo_Text_YukiIntro {
    "I always look before I commit.\p"
    "You'll see my whole team.\n"
    "I'll see yours.\p"
    "Then we decide."
}

text VermilionCity_Dojo_Text_YukiDefeat {
    "Good picks. That's half\n"
    "the battle."
}

text VermilionCity_Dojo_Text_YukiPost {
    "Every match starts before\n"
    "the first move is made."
}

text VermilionCity_Dojo_Text_JinIntro {
    "Fifteen turns.\n"
    "That's all you get.\p"
    "If you can't close it by\n"
    "then, you weren't ready."
}

text VermilionCity_Dojo_Text_JinDefeat {
    "Quick and clean.\n"
    "You knew what to do."
}

text VermilionCity_Dojo_Text_JinPost {
    "Efficiency isn't speed.\n"
    "It's not wasting what\l"
    "you have."
}

text VermilionCity_Dojo_Text_AkioIntro {
    "NORMAL types.\n"
    "Only NORMAL types.\p"
    "The most common things in\n"
    "this region.\p"
    "Show me you understand\n"
    "what you already have."
}

text VermilionCity_Dojo_Text_AkioDefeat {
    "Good. You didn't overcomplicate\n"
    "it."
}

text VermilionCity_Dojo_Text_AkioPostBattle {
    "A researcher who ignores\n"
    "common POKéMON misses\l"
    "half the picture.\p"
    "They're everywhere for a\n"
    "reason.\p"
    "These are for your fieldwork."
}

text VermilionCity_Dojo_Text_ChallengeGuyIntro {
    "Welcome to the Attack Dojo!\p"
    "Pick your challenge.\p"
    "TRAINING matches whatever belt\n"
    "you've earned, scaled to your\l"
    "level. It won't count toward\n"
    "unlocking the next belt."
}

text VermilionCity_Dojo_Text_ChallengeTrainingSet {
    "Training mode selected.\n"
    "Opponents will match your level."
}

text VermilionCity_Dojo_Text_ChallengeWhiteSet {
    "White Belt challenge selected.\n"
    "Go find your opponents."
}

text VermilionCity_Dojo_Text_ChallengeBlueSet {
    "Blue Belt challenge selected.\n"
    "Go find your opponents."
}

text VermilionCity_Dojo_Text_ChallengeBlueLocked {
    "Clear White Belt against all\n"
    "four of us before you try Blue."
}

text VermilionCity_Dojo_Text_ChallengeBlackSet {
    "Black Belt challenge selected.\n"
    "Go find your opponents."
}

text VermilionCity_Dojo_Text_ChallengeBlackLocked {
    "Clear Blue Belt against all\n"
    "four of us before you try Black."
}

text VermilionCity_Dojo_Text_ChallengeGuyIntroGauntlet {
    "Welcome to the Attack Dojo!\p"
    "Pick your challenge.\p"
    "TRAINING matches whatever belt\n"
    "you've earned, scaled to your\l"
    "level. It won't count toward\n"
    "unlocking the next belt.\p"
    "Since you've beaten all of us\n"
    "at Black Belt... there's one\l"
    "more thing.\p"
    "The GAUNTLET. All four of us,\n"
    "back to back. No leaving to\l"
    "heal. No second chances."
}

text VermilionCity_Dojo_Text_ChallengeGauntletSet {
    "Gauntlet selected.\n"
    "Don't leave until it's done."
}

text VermilionCity_Dojo_Text_GauntletCleared {
    "...\p"
    "All four of us, back to back,\n"
    "and you never once walked out\l"
    "that door.\p"
    "That's the Gauntlet.\n"
    "You've earned it."
}

text VermilionCity_Dojo_Text_Plaque {
    "AKIO'S DOJO\p"
    "Observation precedes action.\n"
    "Action precedes understanding."
}

text VermilionCity_Dojo_Text_ScrollLeft {
    "The untrained eye sees a\n"
    "common bird.\l"
    "The trained eye sees how\n"
    "it holds its wings."
}

text VermilionCity_Dojo_Text_ScrollRight {
    "There is no weak POKéMON.\n"
    "There is only the trainer\l"
    "who stopped looking."
}

text VermilionCity_Dojo_Text_Machop {
    "The MACHOP trains here every day.\n"
    "It hasn't missed one."
}

text VermilionCity_Dojo_Text_Mankey {
    "The MANKEY gets worked up\n"
    "watching the sparring matches."
}

text VermilionCity_Dojo_Text_Hitmonchan {
    "The HITMONCHAN watches every\n"
    "match without blinking.\p"
