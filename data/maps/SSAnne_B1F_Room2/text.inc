SSAnne_B1F_Room2_Text_HueyGreeting::
    .string "Ahoy, Samuel! I'm Huey, the ship's\n"
    .string "quartermaster.\p"
    .string "I handle expedition settings and\n"
    .string "battle calibrations for our crew.\p"
    .string "Would you like to adjust any settings\n"
    .string "for your journey across Kanto?$"

SSAnne_B1F_Room2_Text_Huey_ToggleWildScaling::
    .string "Wild Scaling$"

SSAnne_B1F_Room2_Text_Huey_ToggleDoubleFlag::
    .string "1-Mon Doubles$"

SSAnne_B1F_Room2_Text_Huey_SetLevelOffset::
    .string "Boss Level Offset$"

SSAnne_B1F_Room2_Text_Huey_ExplainSettings::
    .string "Explain Settings$"

SSAnne_B1F_Room2_Text_Huey_Close::
    .string "Done$"

SSAnne_B1F_Room2_Text_Huey_WildScalingEnabled::
    .string "Wild POKéMON level scaling is now ON!\p"
    .string "Wild POKéMON encounters will dynamically\n"
    .string "scale to match your team's level.$"

SSAnne_B1F_Room2_Text_Huey_WildScalingDisabled::
    .string "Wild POKéMON level scaling is now OFF.\p"
    .string "Wild POKéMON will appear at their\n"
    .string "default area levels.$"

SSAnne_B1F_Room2_Text_Huey_DoubleFlagEnabled::
    .string "1-Mon Double Battles are now ON!\p"
    .string "You can now participate in double\n"
    .string "battles even with only one POKéMON.$"

SSAnne_B1F_Room2_Text_Huey_DoubleFlagDisabled::
    .string "1-Mon Double Battles are now OFF.\p"
    .string "Double battles will require at least two\n"
    .string "conscious POKéMON in your party.$"

SSAnne_B1F_Room2_Text_Huey_ChooseOffset::
    .string "Choose a level offset for boss battles.\n"
    .string "Current setting will be adjusted.$"

SSAnne_B1F_Room2_Text_Huey_Offset0::
    .string "Standard (+0)$"

SSAnne_B1F_Room2_Text_Huey_OffsetPlus5::
    .string "Hard (+5)$"

SSAnne_B1F_Room2_Text_Huey_OffsetPlus10::
    .string "Challenge (+10)$"

SSAnne_B1F_Room2_Text_Huey_OffsetMinus5::
    .string "Easy (-5)$"

SSAnne_B1F_Room2_Text_Huey_OffsetMinus10::
    .string "Casual (-10)$"

SSAnne_B1F_Room2_Text_Huey_OffsetBack::
    .string "Back$"

SSAnne_B1F_Room2_Text_Huey_OffsetSet::
    .string "Boss level scaling offset has been\n"
    .string "calibrated!$"

SSAnne_B1F_Room2_Text_Huey_ExplainText::
    .string "Here is how our expedition calibrations\n"
    .string "work:\p"
    .string "Wild Scaling: Wild POKéMON will match\n"
    .string "the level of your strongest partner.\p"
    .string "1-Mon Doubles: Allows taking on double\n"
    .string "battles even without a second POKéMON.\p"
    .string "Boss Level Offset: Adds or subtracts\n"
    .string "levels during scaled boss encounters,\n"
    .string "letting you customize the challenge.$"

SSAnne_B1F_Room2_Text_HueyFarewell::
    .string "Fair winds, Samuel! Stop by anytime\n"
    .string "you need to adjust calibrations.$"
