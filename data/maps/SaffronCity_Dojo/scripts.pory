text SaffronCity_Dojo_Text_ChallengeGuyIntro {
    "Welcome to the Speed Dojo!\p"
    "Pick your challenge.\p"
    "TRAINING matches whatever belt\n"
    "you've earned, scaled to your\l"
    "level. It won't count toward\n"
    "unlocking the next belt."
}

text SaffronCity_Dojo_Text_ChallengeTrainingSet {
    "Training mode selected.\n"
    "Opponents will match your level."
}

text SaffronCity_Dojo_Text_ChallengeWhiteSet {
    "White Belt challenge selected.\n"
    "Go find your opponents."
}

text SaffronCity_Dojo_Text_ChallengeBlueSet {
    "Blue Belt challenge selected.\n"
    "Go find your opponents."
}

text SaffronCity_Dojo_Text_ChallengeBlueLocked {
    "Clear White Belt against all\n"
    "five of us before you try Blue."
}

text SaffronCity_Dojo_Text_ChallengeBlackSet {
    "Black Belt challenge selected.\n"
    "Go find your opponents."
}

text SaffronCity_Dojo_Text_ChallengeBlackLocked {
    "Clear Blue Belt against all\n"
    "five of us before you try Black."
}

text SaffronCity_Dojo_Text_ChallengeGuyIntroGauntlet {
    "Welcome to the Speed Dojo!\p"
    "Pick your challenge.\p"
    "TRAINING matches whatever belt\n"
    "you've earned, scaled to your\l"
    "level. It won't count toward\n"
    "unlocking the next belt.\p"
    "Since you've beaten all of us\n"
    "at Black Belt... there's one\l"
    "more thing.\p"
    "The GAUNTLET. All five of us,\n"
    "back to back. No leaving to\l"
    "heal. No second chances."
}

text SaffronCity_Dojo_Text_ChallengeGauntletSet {
    "Gauntlet selected.\n"
    "Don't leave until it's done."
}

text SaffronCity_Dojo_Text_GauntletCleared {
    "...\p"
    "All five of us, back to back,\n"
    "and you never once walked out\l"
    "that door.\p"
    "That's the Gauntlet.\n"
    "You've earned it."
}

text SaffronCity_Dojo_Text_ComeBackWhenReady {
    "Come back when you're ready."
}

text SaffronCity_Dojo_Text_MasterKoichiIntro {
