mapscripts FuchsiaCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: FuchsiaCity_OnTransition
}

script FuchsiaCity_OnTransition {
    setworldmapflag(FLAG_WORLD_MAP_FUCHSIA_CITY)
    if (flag(FLAG_GOT_DOME_FOSSIL)) {
        setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_OMANYTE)
    } else {
        setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_KABUTO)
    }
    end
}

// Called when player talks to Fuji in Fuchsia City.
// Routes to the turn-in scene only after the quest is active
// AND the player has actually caught at least one KRABBY.
script FuchsiaCity_EventScript_FujiTalk {
    if (flag(FLAG_KRABBY_QUEST_COMPLETE)) {
        lock
        faceplayer
        msgbox("Come back when you've had\n"
               "more time in the field.\p"
               "There's more to document\n"
               "out there.")
        closemessage
        release
        end
    }
    if (flag(FLAG_KRABBY_QUEST_GIVEN)) {
        // Count KRABBY anywhere in the party (not just slots 0-1) — empty
        // slots read back SPECIES_NONE from ScriptGetPartyMonSpecies, so
        // it's safe to check all 6 regardless of actual party size.
        setvar(VAR_0x8006, 0)
        setvar(VAR_0x8004, 0)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        setvar(VAR_0x8004, 1)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        setvar(VAR_0x8004, 2)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        setvar(VAR_0x8004, 3)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        setvar(VAR_0x8004, 4)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        setvar(VAR_0x8004, 5)
        specialvar(VAR_RESULT, ScriptGetPartyMonSpecies)
        if (var(VAR_RESULT) == SPECIES_KRABBY) {
            addvar(VAR_0x8006, 1)
        }
        if (var(VAR_0x8006) < 2) {
            lock
            faceplayer
            msgbox("The shallows south of here.\p"
                   "Bring two KRABBY in your\n"
                   "party before you come find me.")
            closemessage
            release
            end
        }
        goto(FuchsiaCity_EventScript_FujiTurnIn)
        end
    }
    msgbox("Good country, this.\n"
           "Take your time looking around.", MSGBOX_NPC)
    end
}

// The turn-in scene. Fires only from FujiTalk after caught check passes.
script FuchsiaCity_EventScript_FujiTurnIn {
    lockall
    setvar(VAR_ACT1_FUCHSIA, 1)
    showmugshot(MUGSHOT_AGATHA, MUGSHOT_LEFT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("You're slow, Sammy.\n"
           "I got mine on the way down.")
    closemessage
    clearmugshot
    //showmugshot(MUGSHOT_FUJI, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("Bring both sets over here.")
    closemessage
    msgbox("See these two? Same species.\n"
           "Same location. One is noticeably\l"
           "larger than the other.\p"
           "That difference isn't arbitrary.\n"
           "It affects how they move, how\l"
           "hard they hit, how fast they\l"
           "recover.\p"
           "This is the first thing I need\n"
           "you to understand about what\l"
           "we're doing here.\p"
           "Individual differences in\n"
           "POKéMON are real.\n"
           "They matter.")
    closemessage
    msgbox("This land behind us has been\n"
           "set aside - a conservation\l"
           "agreement I've been working on\n"
           "for years.\p"
           "The idea is simple: we document\n"
           "the POKéMON being displaced,\l"
           "and we give them somewhere\l"
           "to go.\p"
           "It's not much yet.\n"
           "But it grows with what we\l"
           "contribute.\p"
           "These four KRABBY will be\n"
           "the first.")
    closemessage
    showmugshot(MUGSHOT_AGATHA, MUGSHOT_LEFT)
    textcolor(NPC_TEXT_COLOR_FEMALE)
    msgbox("How do you know they'll stay?")
    closemessage
    clearmugshot
    //showmugshot(MUGSHOT_FUJI, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("They won't all stay.\n"
           "That's not the point.\p"
           "The point is to give them\n"
           "the choice.")
    closemessage
    msgbox("Come inside for a moment.\p"
           "There's two people you should\n"
           "meet before you head back out.")
    closemessage
    applymovement(LOCALID_FUCHSIA_FUJI, FuchsiaCity_Movement_FujiToDoor)
    applymovement(LOCALID_FUCHSIA_AGATHA, FuchsiaCity_Movement_AgathaToDoor)
    applymovement(OBJ_EVENT_ID_PLAYER, FuchsiaCity_Movement_PlayerToDoor)
    waitmovement(0)
    setflag(FLAG_HIDE_FUCHSIA_AGATHA)
    setflag(FLAG_HIDE_FUCHSIA_FUJI)
    warp(MAP_FUCHSIA_CITY_RESERVE, 4, 6)
    waitstate
    releaseall
    end
}

// The rest of the scene (Worker introductions, the Protoball/Silph Co.
// foreshadowing, the fishing village warning, and Agatha's exit) plays
// out in FuchsiaCity_Reserve_EventScript_Intro once the warp above lands.
// That script also sets FLAG_KRABBY_QUEST_COMPLETE once it finishes.

movement FuchsiaCity_Movement_FujiToDoor {
    walk_up * 2
    set_invisible
}

movement FuchsiaCity_Movement_AgathaToDoor {
    walk_up * 2
    set_invisible
}

movement FuchsiaCity_Movement_PlayerToDoor {
    walk_up * 2
}

script FuchsiaCity_EventScript_Youngster {
    lock
    faceplayer
    msgbox("Hey! Want to test the Slowpoke evolution?\nI found a wild Shellder!", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        msgbox("Here it comes!", MSGBOX_DEFAULT)
        closemessage
        setflag(FLAG_QUEST_KNOW_SLOWPOKE_EVOS)
        callnative(Script_SetShellderTestWildBattle)
        dowildbattle
    } else {
        msgbox("Let me know if you change your mind!", MSGBOX_DEFAULT)
        closemessage
    }
    release
    end
}

raw `
FuchsiaCity_EventScript_LittleBoy::
	msgbox FuchsiaCity_Text_DidYouTrySafariGame, MSGBOX_NPC
	end

FuchsiaCity_EventScript_OldMan::
	msgbox FuchsiaCity_Text_SafariZoneZooInFront, MSGBOX_NPC
	end

FuchsiaCity_EventScript_Erik::
	msgbox FuchsiaCity_Text_WheresSara, MSGBOX_NPC
	end

FuchsiaCity_EventScript_Lass::
	lock
	faceplayer
	famechecker FAMECHECKER_KOGA, 3
	msgbox FuchsiaCity_Text_MyFatherIsGymLeader
	release
	end

FuchsiaCity_EventScript_CitySign::
	msgbox FuchsiaCity_Text_CitySign, MSGBOX_SIGN
	end

FuchsiaCity_EventScript_SafariZoneSign::
	msgbox FuchsiaCity_Text_SafariZoneSign, MSGBOX_SIGN
	end

FuchsiaCity_EventScript_SafariGameSign::
	msgbox FuchsiaCity_Text_SafariGameSign, MSGBOX_SIGN
	end

FuchsiaCity_EventScript_WardensHomeSign::
	msgbox FuchsiaCity_Text_WardensHomeSign, MSGBOX_SIGN
	end

FuchsiaCity_EventScript_SafariZoneOfficeSign::
	msgbox FuchsiaCity_Text_SafariZoneOfficeSign, MSGBOX_SIGN
	end

FuchsiaCity_EventScript_GymSign::
	lockall
	famechecker FAMECHECKER_KOGA, 0
	msgbox FuchsiaCity_Text_GymSign
	releaseall
	end

FuchsiaCity_EventScript_ChanseySign::
	lockall
	setvar VAR_0x8004, SPECIES_CHANSEY
	special SetSeenMon
	showmonpic SPECIES_CHANSEY, 10, 3
	msgbox FuchsiaCity_Text_ChanseySign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_VoltorbSign::
	lockall
	setvar VAR_0x8004, SPECIES_VOLTORB
	special SetSeenMon
	showmonpic SPECIES_VOLTORB, 10, 3
	msgbox FuchsiaCity_Text_VoltorbSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_KangaskhanSign::
	lockall
	setvar VAR_0x8004, SPECIES_KANGASKHAN
	special SetSeenMon
	showmonpic SPECIES_KANGASKHAN, 10, 3
	msgbox FuchsiaCity_Text_KangaskhanSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_SlowpokeSign::
	lockall
	setvar VAR_0x8004, SPECIES_SLOWPOKE
	special SetSeenMon
	showmonpic SPECIES_SLOWPOKE, 10, 3
	msgbox FuchsiaCity_Text_SlowpokeSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_LaprasSign::
	lockall
	setvar VAR_0x8004, SPECIES_LAPRAS
	special SetSeenMon
	showmonpic SPECIES_LAPRAS, 10, 3
	msgbox FuchsiaCity_Text_LaprasSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_FossilMonSign::
	lockall
	goto_if_set FLAG_GOT_DOME_FOSSIL, FuchsiaCity_EventScript_OmanyteSign
	setvar VAR_0x8004, SPECIES_KABUTO
	special SetSeenMon
	showmonpic SPECIES_KABUTO, 10, 3
	msgbox FuchsiaCity_Text_KabutoSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_OmanyteSign::
	setvar VAR_0x8004, SPECIES_OMANYTE
	special SetSeenMon
	showmonpic SPECIES_OMANYTE, 10, 3
	msgbox FuchsiaCity_Text_OmanyteSign
	hidemonpic
	releaseall
	end

FuchsiaCity_EventScript_Fuji::
	goto FuchsiaCity_EventScript_FujiTalk

FuchsiaCity_EventScript_Agatha::
	lock
	faceplayer
	showmugshot MUGSHOT_AGATHA, MUGSHOT_LEFT
	textcolor NPC_TEXT_COLOR_FEMALE
	msgbox FuchsiaCity_Text_AgathaIdle, MSGBOX_DEFAULT
	clearmugshot
	release
	end

FuchsiaCity_Text_AgathaIdle:
	.string "We have work to do.$"
`
