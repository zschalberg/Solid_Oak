const SilphCoScientist = 1

mapscripts SilphCo_2F_MapScripts {
    MAP_SCRIPT_ON_LOAD: SilphCo_2F_OnLoad
}

script SilphCo_2F_OnLoad {
    call_if_unset(FLAG_SILPH_2F_DOOR_1, EventScript_Close2FDoor1)
//    call_if_unset(FLAG_SILPH_2F_DOOR_2, EventScript_Close2FDoor2)
    end
}

// Single event object (see map.json) - always routes through here.
// First meeting hands out the PROTOBALLS. Once that quest is active,
// repeat visits check the party for a turn-in. Once resolved, idle chat.
script SilphCoScientist_Give_Protoball {
    if (var(VAR_SCENE_SILPH) >= 3) {
        lock
        faceplayer
        showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
        textcolor(NPC_TEXT_COLOR_MALE)
        msgbox("The data from your PROTOBALLS\n"
               "is already proving useful.\p"
               "We'll let you know when we need\n"
               "more field testing.")
        closemessage
        clearmugshot
        release
        end
    }
    if (var(VAR_SCENE_SILPH) == 2) {
        goto(SilphCoScientist_EventScript_CheckProtoballTurnIn)
        end
    }
    if (var(VAR_SCENE_SILPH) == 0) {
        lock
        faceplayer
        showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
        textcolor(NPC_TEXT_COLOR_MALE)
        msgbox("We're currently conducting research\n"
               "on Pokémon containment devices.\l"
               "Check back later!")
        closemessage
        clearmugshot
        release
        end
    }
    lock
    faceplayer
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("Ah you must be Oak! \n"
            "Great, I could use some help.\p"
            "We're working on making containment \n"
            "devices for Pokemon. So far the \l"
            "science is theoretically sound,\l"
            "but we need someone to test it\l"
            "in the field.")
    closemessage
    clearmugshot
    giveitem(ITEM_RED_PROTOBALL, 2)
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("These are PROTOBALLS. \p"
            "Using the design of Mr. Fuji's\n"
            "RESEARCH BALLS as a base we\l"
            "were able to create a version\l"
            "that allows for Pokemon to be\l"
            "released into the field without\l"
            "them immediately running away.\p"
            "The downside is they only work on \n"
            "weaker Pokemon for now, but we're\l"
            "working on improving that.\p"
            "Go out and catch some Pokemon and \n"
            "bring them back here for testing.\p"
            "Any 2 Pokemon will do!")
    setflag(FLAG_QUEST_SILPH_TESTING_COMPLETED)
    setflag(FLAG_QUEST_REDPROTOBALL_ACTIVE)
    quest_complete_toast("SILPH TESTING")
    quest_start_toast(COMPOUND_STRING("PROTOBALL TESTING"))
    setvar(VAR_SCENE_SILPH, 2)
    release
    end
}

// Counts party members specifically caught with a Red Protoball - not
// just any 2 non-starter mons, and not Research Balls either, since the
// player can have both ball types active at this point in the story.
script SilphCoScientist_EventScript_CheckProtoballTurnIn {
    specialvar(VAR_0x8006, CountRedProtoballCaughtMons)

    if (var(VAR_0x8006) < 2) {
        lock
        faceplayer
        showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
        textcolor(NPC_TEXT_COLOR_MALE)
        msgbox("Still need two POKéMON caught\n"
               "with the PROTOBALLS I gave you.\l"
               "Research Balls won't work for\l"
               "this test.")
        closemessage
        clearmugshot
        release
        end
    }
    goto(SilphCoScientist_EventScript_ProtoballTurnIn)
    end
}

// Fires only from the dispatcher above, after the party check passes.
script SilphCoScientist_EventScript_ProtoballTurnIn {
    lockall
    faceplayer
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("These the two you caught? \n"
           "Perfect, that's all we need.\p"
           "The PROTOBALL held up fine out\n"
           "there. That's good news for the\l"
           "containment side of things.")
    closemessage
    clearmugshot
    checkitem(ITEM_BLUE_APRICORN, 2)
    if (var(VAR_RESULT) == FALSE) {
        showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
        textcolor(NPC_TEXT_COLOR_MALE)
        msgbox("There's something else, though.\p"
               "To hold anything stronger we'll\n"
               "need a better containment shell -\l"
               "two BLUE APRICORNS ought to do it.\p"
               "I hear they grow out on ROUTE 8,\n"
               "east of here.")
        closemessage
        clearmugshot
        release
        end
    }
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("There's something else, though.\n"
           "Come with me.")
    closemessage
    clearmugshot
    specialvar(VAR_RESULT, GetPlayerFacingDirection)
    if (var(VAR_RESULT) == DIR_WEST) {
        applymovement(OBJ_EVENT_ID_PLAYER, SilphCo_Movement_FromEast)
        applymovement(SilphCoScientist, SilphCo_Movement_ToDoor)
    } elif (var(VAR_RESULT) == DIR_SOUTH) {
        applymovement(OBJ_EVENT_ID_PLAYER, SilphCo_Movement_FromSouth)
        applymovement(SilphCoScientist, SilphCo_Movement_ToDoor)
    } elif (var(VAR_RESULT) == DIR_EAST) {
        applymovement(OBJ_EVENT_ID_PLAYER, SilphCo_Movement_FromWest)
        applymovement(SilphCoScientist, SilphCo_Movement_ToDoor)
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, SilphCo_Movement_ToDoor)
        applymovement(SilphCoScientist, SilphCo_Movement_ToDoor)
    }
    waitmovement(SilphCoScientist)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setflag(FLAG_SILPH_2F_DOOR_1)
    call(EventScript_Open2FDoor1)
    playse(SE_UNLOCK)
    special(DrawWholeMapView)
    waitse
    applymovement(SilphCoScientist, SilphCo_Movement_ToWorkbench)
    applymovement(OBJ_EVENT_ID_PLAYER, SilphCo_Movement_PlayerToWorkbench)
    waitmovement(SilphCoScientist)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    showmugshot(MUGSHOT_PROF_ARBOR, MUGSHOT_RIGHT)
    textcolor(NPC_TEXT_COLOR_MALE)
    msgbox("While we've got you here, let's\n"
           "upgrade those PROTOBALLS with what\l"
           "we learned from the field test.")
    removeitem(ITEM_BLUE_APRICORN, 2)
    special(UpgradeRedProtoballCaughtMons)
    msgbox("There - those are BLU PROTOBALLS\n"
           "now. Should hold up against\l"
           "tougher Pokemon.")
    closemessage
    clearmugshot

    setvar(VAR_SCENE_SILPH, 3)
    setflag(FLAG_QUEST_REDPROTOBALL_COMPLETED)
    quest_complete_toast
    setflag(FLAG_QUEST_SILPH_FOLLOWUP_ACTIVE)
    quest_start_toast
    releaseall
    end
}

movement SilphCo_Movement_ToDoor {
    walk_down * 3
    delay_16
}

movement SilphCo_Movement_ToWorkbench {
    walk_down * 7
    walk_right * 6
    face_down
    delay_16 * 4
    face_left
}

movement SilphCo_Movement_FromEast {
    walk_left
    walk_down * 2
    delay_16
}

movement SilphCo_Movement_FromWest {
    walk_right
    walk_down * 2
    delay_16
}

movement SilphCo_Movement_FromSouth {
    slide_left
    walk_right
    walk_down
    delay_16
}

movement SilphCo_Movement_PlayerToWorkbench {
    walk_down * 8
    walk_right * 5
}